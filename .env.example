APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio1308
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Background jobs (no-show detection, ACH payouts, notifications) run on
# this queue — see routes/console.php for the scheduled dispatches.
# QUEUE_CONNECTION=redis is recommended in production for lower latency
# under load; "database" (used here) needs no extra infrastructure and is
# fine for a single-location salon's traffic.
QUEUE_CONNECTION=database

# CACHE_STORE backs SlotService's 5-minute availability cache (see
# app/Services/SlotService.php). "redis" is recommended in production
# (per the spec) for faster invalidation under concurrent bookings;
# "database" works everywhere without extra infrastructure and is what
# local development uses here.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log writes emails to the log instead of sending them —
# fine until Step 9 builds the Mailable/Blade templates. For production,
# switch to smtp/mailgun/ses/postmark and set real credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (USA payments, tipping, no-show charges, ACH staff payouts).
# Populated in Step 8 once the Stripe SDK is installed; the app runs
# fine without these until then (payment methods throw a clear
# "implemented in Step 8" error rather than failing silently).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
