# In production: APP_ENV=production, APP_DEBUG=false (never true — it leaks
# stack traces and env values to visitors), APP_URL=https://your-real-domain.
# See docs/DEPLOYMENT.md for the full production checklist.
APP_NAME="1308Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# LOG_STACK=single (one never-rotated file) is fine for local dev. In
# production, use "daily" instead so storage/logs/ doesn't grow forever —
# see docs/DEPLOYMENT.md.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio1308
DB_USERNAME=root
DB_PASSWORD=

# Only set in production, and only to the IP(s)/CIDR of your actual reverse
# proxy or load balancer (or "*" if you're certain every request is already
# proxied). Leave blank to trust no proxy — see bootstrap/app.php. Wrong/loose
# values here let a client spoof its own IP or scheme via X-Forwarded-* headers.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true in production (requires HTTPS, which production already
# forces — see AppServiceProvider). Stays false here so local http:// dev
# doesn't silently drop the session cookie on every request.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Background jobs (no-show detection, ACH payouts, notifications) run on
# this queue — see routes/console.php for the scheduled dispatches.
# QUEUE_CONNECTION=redis is recommended in production for lower latency
# under load; "database" (used here) needs no extra infrastructure and is
# fine for a single-location salon's traffic.
QUEUE_CONNECTION=database

# CACHE_STORE backs SlotService's 5-minute availability cache (see
# app/Services/SlotService.php). "redis" is recommended in production
# (per the spec) for faster invalidation under concurrent bookings;
# "database" works everywhere without extra infrastructure and is what
# local development uses here.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log writes emails to storage/logs/laravel.log instead of
# sending them — the Step 9 Mailable/Blade templates are real and fully
# wired up, this is just standing in for real SMTP credentials. For
# production, switch to smtp/mailgun/ses/postmark and set real credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ritualbarberstudio.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (USA payments, tipping, no-show charges, ACH staff payouts).
# The app runs fine without these — the customer payment page and admin
# "Verify with Stripe" action both degrade to a clear "not connected yet"
# state rather than failing. Fill these in with real (test or live) keys
# whenever you're ready to accept real payments.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Error tracking (optional). Leave blank to disable — the app works
# identically either way, you just won't get exception alerts/context.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

VITE_APP_NAME="${APP_NAME}"
